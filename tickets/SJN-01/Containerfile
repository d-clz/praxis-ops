# syntax=docker/dockerfile:1
# Bare local name, not a registry.local@sha256 pin: no registry exists on this
# host and policy.json doesn't even permit the docker transport a
# registry-shaped FROM would need. bootstrap/60-build-base.sh imports the base
# under this exact name -- podman build resolves it straight from local
# containers-storage, no network involved.
FROM praxis/ops-base

COPY seed.sh /tmp/seed.sh
COPY entrypoint.sh /opt/praxis/entrypoint.sh
RUN /bin/bash /tmp/seed.sh && rm -f /tmp/seed.sh && chmod 0755 /opt/praxis/entrypoint.sh

# Root inside the sandbox is required (the candidate must inspect /proc and kill a
# process they do not own). Under rootless podman this root is namespaced.
USER root
WORKDIR /root
CMD ["/opt/praxis/entrypoint.sh"]
