# syntax=docker/dockerfile:1
# Bare local name, not a registry.local@sha256 pin: no registry exists on this
# host and policy.json doesn't even permit the docker transport a
# registry-shaped FROM would need. bootstrap/61-build-systemd-base.sh imports
# the base under this exact name -- podman build resolves it straight from
# local containers-storage, no network involved. Confirmed real and hardened
# on the host: bootstrap/50-verify.sh (28/28) and security/verify-shell-
# isolation.sh (7/7) both pass clean against this image.
FROM praxis/ops-systemd

COPY seed.sh /tmp/seed.sh
RUN /bin/bash /tmp/seed.sh && rm -f /tmp/seed.sh

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
